---
import Layout from "../layouts/Layout.astro";

const resources = [
  { name: "Astro Docs", desc: "Astro 官方文档" },
  { name: "EdgeOne Pages Docs", desc: "EdgeOne Pages 官方文档" },
  { name: "Tailwind CSS", desc: "Tailwind 官方文档" },
  { name: "React Docs", desc: "React 官方文档" },
];
---

<Layout title="资源页">
  <main class="mx-auto min-h-screen w-[min(1000px,92%)] py-16">
    <a href="/" class="text-sky-300 hover:underline">← 返回首页</a>

    <h1 class="mt-6 text-4xl font-black">资源导航</h1>
    <p class="mt-4 text-slate-300">这里以后放你常用的网站、工具、教程。</p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        resources.map((item) => (
          <article class="rounded-lg border border-white/10 bg-white/5 p-6">
            <h2 class="text-2xl font-bold">{item.name}</h2>
            <p class="mt-3 text-slate-300">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
