---
import Layout from "../layouts/Layout.astro";
import FloatingMusicPlayer from "../components/FloatingMusicPlayer";
---

<Layout title="我的主题站">
  <main class="mx-auto min-h-screen w-[min(1100px,92%)] py-16">
    <section class="mb-10">
      <span class="inline-block rounded-lg border border-white/15 bg-white/5 px-4 py-2 text-sm text-emerald-300">
        EdgeOne Pages · Astro · React · Tailwind 4
      </span>

      <h1 class="mt-6 text-5xl font-black leading-tight md:text-7xl">
        这不是个人简介，<br />
        这是我的内容基地。
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        这个网站以后会放学习笔记、资源整理、专题页面和交互工具。
        第一版先做内容页 + MBTI 测试，后面再加搜索、标签、统计和更多功能。
      </p>
    </section>

    <section class="grid gap-5 md:grid-cols-3">
      <a
        href="/resources"
        class="rounded-lg border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10"
      >
        <h2 class="text-2xl font-bold">资源页</h2>
        <p class="mt-3 text-slate-300">放网站、软件、工具、教程导航。</p>
      </a>

      <a
        href="/mbti"
        class="rounded-lg border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10"
      >
        <h2 class="text-2xl font-bold">MBTI 测试</h2>
        <p class="mt-3 text-slate-300">第一批交互功能，从这里开始。</p>
      </a>

      <div class="rounded-lg border border-white/10 bg-white/5 p-6">
        <h2 class="text-2xl font-bold">后续扩展</h2>
        <p class="mt-3 text-slate-300">以后再加笔记列表、专题页、统计功能。</p>
      </div>
    </section>
  </main>

  <FloatingMusicPlayer client:load />
</Layout>
